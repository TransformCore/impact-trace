{
  "name": "@transform-uk/impact-trace",
  "version": "0.1.0",
  "description": "ImpactTrace - carbon estimation for web application user journeys in CI",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TransformCore/impact-trace.git"
  },
  "homepage": "https://github.com/TransformCore/impact-trace#readme",
  "bugs": {
    "url": "https://github.com/TransformCore/impact-trace/issues"
  },
  "bin": {
    "impact-trace": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "node --test --import tsx src/**/*.test.ts",
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js"
  },
  "keywords": [
    "carbon",
    "sustainability",
    "ci",
    "playwright",
    "performance"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@tgwf/co2": "^0.18.0",
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
